// /storage.rules
rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  // Assumed path: attachments/org/workspace/project/actor/file.
  // Every operation rechecks active membership and scoped Firestore grants.
  // 0.8.38 (FIX-10): check that the member and grant records exist BEFORE reading them. Before, a person with no record hit a "null value" error on the
  // old line 8 (access was refused anyway, but the emulator warned). The result is the same: no record means no access.
  function roleOf(org, ws, project) {
   let grant = firestore.get(/databases/(default)/documents/orgs/$(org)/workspaces/$(ws)/grants/$(request.auth.uid)).data;
   return ('projects' in grant && project in grant.projects) ? grant.projects[project] : grant.workspaceRole;
  }
  function allowed(org, ws, project, edit) {
   return firestore.exists(/databases/(default)/documents/orgs/$(org)/members/$(request.auth.uid))
    && firestore.exists(/databases/(default)/documents/orgs/$(org)/workspaces/$(ws)/grants/$(request.auth.uid))
    && firestore.get(/databases/(default)/documents/orgs/$(org)/members/$(request.auth.uid)).data.active == true
    && (edit ? roleOf(org, ws, project) in ['contributor', 'manager'] : roleOf(org, ws, project) in ['viewer', 'commenter', 'contributor', 'manager']);
  }
  match /attachments/{org}/{ws}/{project}/{uid}/{file} {
   allow read: if request.auth != null && allowed(org, ws, project, false);
   allow create, update: if request.auth != null && request.auth.uid == uid && allowed(org, ws, project, true)
    && request.resource.size <= 5 * 1024 * 1024
    && request.resource.contentType in ['image/png', 'image/jpeg', 'application/pdf', 'text/plain'];
   allow delete: if request.auth != null && request.auth.uid == uid && allowed(org, ws, project, true);
  }
  match /{allPaths=**} { allow read, write: if false; }
 }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Niyarvo Projects single-file project import v1",
  "type": "object",
  "required": [
    "format",
    "id",
    "name",
    "tasks"
  ],
  "properties": {
    "format": {
      "const": "niyarvo.project.v1"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "stage": {
            "enum": [
              "Development",
              "Testing",
              "Production"
            ]
          },
          "description": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "exit": {
            "type": "string"
          }
        }
      }
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "enum": [
              "Planned",
              "Testing",
              "Ready",
              "Released"
            ]
          },
          "mainSha": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "enum": [
              "Backlog",
              "In progress",
              "Validation",
              "Done"
            ]
          },
          "priority": {
            "enum": [
              "Low",
              "Medium",
              "High",
              "Critical"
            ]
          },
          "stage": {
            "enum": [
              "Development",
              "Testing",
              "Production"
            ]
          },
          "owner": {
            "type": "string"
          },
          "phaseId": {
            "type": "string"
          },
          "releaseId": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "mainSha": {
            "type": "string"
          },
          "due": {
            "type": "string"
          },
          "milestone": {
            "type": "boolean"
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "result": {
                  "enum": [
                    "pending",
                    "passed",
                    "failed",
                    "blocked"
                  ]
                },
                "evidence": {
                  "type": "string"
                }
              }
            }
          },
          "evidence": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          },
          "rollback": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "merged": {
            "type": "boolean"
          },
          "start": {
            "type": "string",
            "description": "ISO YYYY-MM-DD date"
          },
          "position": {
            "type": "number",
            "minimum": 0
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "url"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?://"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "apiContracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "playbooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "automations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "triggerStatus",
          "action",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "triggerStatus": {
            "enum": [
              "Backlog",
              "In progress",
              "Validation",
              "Done"
            ]
          },
          "action": {
            "enum": [
              "priority",
              "stage",
              "owner",
              "dueDays"
            ]
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "archived": {
      "type": "boolean",
      "description": "Archived projects remain in the workspace but are not selectable until restored."
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calendar",
        "links"
      ],
      "properties": {
        "calendar": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "weekdays",
            "closed",
            "opened"
          ],
          "properties": {
            "mode": {
              "enum": [
                "calendar",
                "workdays"
              ]
            },
            "weekdays": {
              "type": "array",
              "minItems": 1,
              "maxItems": 7,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              }
            },
            "closed": {
              "type": "array",
              "maxItems": 4000,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "date"
              }
            },
            "opened": {
              "type": "array",
              "maxItems": 4000,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        "links": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "predecessorId",
              "successorId",
              "type",
              "lagDays"
            ],
            "properties": {
              "predecessorId": {
                "type": "string"
              },
              "successorId": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "FS",
                  "SS",
                  "FF",
                  "SF"
                ]
              },
              "lagDays": {
                "type": "integer",
                "minimum": -365,
                "maximum": 365
              }
            }
          }
        }
      }
    }
  },
  "description": "Version 1 compatible format. v0.2.0 adds optional Kanban ordering, task dependencies, timeline fields, attachment links and status-triggered automations."
}

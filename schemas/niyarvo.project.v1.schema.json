{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Niyarvo Projects single-file project import v1",
  "type": "object",
  "required": [
    "format",
    "id",
    "name",
    "tasks"
  ],
  "properties": {
    "format": {
      "const": "niyarvo.project.v1"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "stage": {
            "enum": [
              "Development",
              "Testing",
              "Production"
            ]
          },
          "description": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "exit": {
            "type": "string"
          }
        }
      }
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "enum": [
              "Planned",
              "Testing",
              "Ready",
              "Released"
            ]
          },
          "mainSha": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "enum": [
              "Backlog",
              "In progress",
              "Validation",
              "Done"
            ]
          },
          "priority": {
            "enum": [
              "Low",
              "Medium",
              "High",
              "Critical"
            ]
          },
          "stage": {
            "enum": [
              "Development",
              "Testing",
              "Production"
            ]
          },
          "owner": {
            "type": "string"
          },
          "phaseId": {
            "type": "string"
          },
          "releaseId": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "mainSha": {
            "type": "string"
          },
          "due": {
            "type": "string"
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "result": {
                  "enum": [
                    "pending",
                    "passed",
                    "failed",
                    "blocked"
                  ]
                },
                "evidence": {
                  "type": "string"
                }
              }
            }
          },
          "evidence": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          },
          "rollback": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "merged": {
            "type": "boolean"
          }
        }
      }
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "apiContracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "playbooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
